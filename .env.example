# Đường dẫn DB SQLite (tính từ thư mục gốc dự án, dùng ở runtime)
DATABASE_PATH=./prisma/dev.db

# mock | payos
PAYMENT_PROVIDER=mock

# Điền khi chuyển sang PayOS thật/sandbox (https://payos.vn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Mật khẩu trang /admin
ADMIN_PASSWORD=umoja-admin

# URL gốc của site (dùng sinh QR tĩnh + returnUrl PayOS)
SITE_URL=http://localhost:3000
