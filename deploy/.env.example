# ===== File .env trên VPS (/opt/umoja/.env) — KHÔNG đưa lên GitHub =====

# Tên miền (không có https://) — Caddy dùng để cấp HTTPS
DOMAIN=ten-mien-cua-ban.vn

# Image do GitHub Actions build (chữ thường): ghcr.io/<tài-khoản-github>/<tên-repo>:latest
APP_IMAGE=ghcr.io/ten-tai-khoan/tre-em-chau-phi:latest

# URL gốc của site (dùng cho QR tĩnh từng tòa + link quay về của PayOS)
SITE_URL=https://ten-mien-cua-ban.vn

# mock = giả lập (không có tiền thật) | payos = thanh toán thật qua PayOS
PAYMENT_PROVIDER=mock
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Bật nút "Phá nhanh (test)" trên online (mặc định TẮT để không làm bẩn dữ liệu thật)
# ENABLE_TEST_TOOLS=1

# Mật khẩu trang quản trị — ĐỔI thành chuỗi dài, khó đoán
ADMIN_PASSWORD=doi-mat-khau-nay
